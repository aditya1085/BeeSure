rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && 'email' in request.auth.token && (
        request.auth.token.email.lower() in [
          'beast.546766@gmail.com',
          'ashugarg1243@gmail.com',
          'gargashu138@gmail.com',
          'gargashu148@gmail.com',
          'commercial1085@gmail.com',
          'adityatripathi8989@gmail.com',
          'adityatripathi1085@gmail.com',
          'adityatripathi240815@acropolis.in',
          'admin.honeychain@gmail.com',
          'admin@honeychain.in',
          'admin.demo@honeychain.in'
        ]
      );
    }

    function isAdmin() {
      return isSuperAdminEmail() || (isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      ));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSamplePayload() {
      return request.resource != null && request.resource.data.get('isSample', false) == true;
    }

    function isSampleDoc() {
      return resource != null && resource.data.get('isSample', false) == true;
    }

    function isLab() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'LAB') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('labId', '') != '')
      );
    }

    function getAuthBeekeeperId() {
      return exists(/databases/$(database)/documents/beekeepers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/beekeepers/$(request.auth.uid)).data.get('beekeeperId', '')
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('beekeeperId', '')
            : '');
    }

    function isHiveOwner() {
      return isSignedIn() && (
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (resource != null && 'beekeeperId' in resource.data && getAuthBeekeeperId() != '' && resource.data.beekeeperId == getAuthBeekeeperId())
      );
    }

    function isHarvestOwner() {
      return isSignedIn() && (
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (resource != null && 'beekeeperId' in resource.data && getAuthBeekeeperId() != '' && resource.data.beekeeperId == getAuthBeekeeperId())
      );
    }

    // Test connection probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Users
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Beekeepers
    match /beekeepers/{beekeeperDocId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Counters for Atomic ID Generation
    match /counters/{counterId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Hives (Public read for consumer traceability, map explorer, and platform counters; authenticated owner/admin write)
    match /hives/{hiveDocId} {
      allow get, list: if true;
      allow create: if isSamplePayload() || (isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        (getAuthBeekeeperId() != '' && request.resource.data.get('beekeeperId', '') == getAuthBeekeeperId())
      ));
      allow update: if isSamplePayload() || (isSignedIn() && (isAdmin() || isLab() || isHiveOwner()));
      allow delete: if isAdmin() || (isHiveOwner() && isSampleDoc());
    }

    // IoT Devices
    match /iotDevices/{deviceId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Sensor Readings (Time-series)
    match /sensorReadings/{readingId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Species Thresholds (Admin-configurable limits)
    match /speciesThresholds/{thresholdId} {
      allow get, list: if true;
      allow write: if true;
    }

    // Health Alerts
    match /healthAlerts/{alertId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Hive Approval Queue
    match /hive_approval_queue/{queueId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Lab Verification Requests
    match /lab_verification_requests/{requestId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Disease Scans (Gemini Vision AI Brood Inspection)
    match /diseaseScans/{scanId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Activity Logs (Append-Only)
    match /activityLogs/{logId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Harvests (Beekeepers record extracted honey - public read for batch inspection & consumer QR traceability)
    match /harvests/{harvestId} {
      allow get, list: if true;
      allow create: if isSamplePayload() || (isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        (getAuthBeekeeperId() != '' && request.resource.data.get('beekeeperId', '') == getAuthBeekeeperId())
      ));
      allow update: if isSamplePayload() || isAdmin() || isHarvestOwner();
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Batches (Aggregated honey batches with verification & lab testing state machine)
    match /batches/{batchId} {
      allow get, list: if true;
      allow create, update: if isSamplePayload() || isSignedIn();
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Labs (Accredited Testing Facilities)
    match /labs/{labId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Lab Samples (Physical samples dispatched for purity analysis)
    match /labSamples/{sampleId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Lab Reports (Purity test parameters and cryptographic hash. Strict lab-only integrity)
    match /labReports/{reportId} {
      allow get, list: if true;
      allow create, update: if isSamplePayload() || isSignedIn();
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Retail Packages (Individual QR-tagged honey jars)
    match /packages/{packageId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Marketplace Listings
    match /listings/{listingId} {
      allow get, list: if true;
      allow create, update: if isSamplePayload() || isSignedIn();
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Customer Orders
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Beekeeper Payouts
    match /payouts/{payoutId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Reviews & Beekeeper Replies
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Trust Scores
    match /trust_scores/{beekeeperId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Stock Alerts
    match /stock_alerts/{alertId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Cryptographic Ledger Blocks (Strictly Append-Only, Zero Edits or Deletions Allowed)
    match /ledgerRecords/{blockId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable!
    }

    // Cryptographic Ledger Head
    match /ledger_head/{headId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Platform Settings
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    // Pre-computed System Analytics Stats
    match /system_stats/{statId} {
      allow get, list: if true;
      allow write: if true;
    }

    // Customer Order Disputes & Refunds
    match /disputes/{disputeId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSampleDoc();
    }

    // Comprehensive Audit Logs
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
